{
  "$schema": "node_modules/wrangler/config-schema.json",

  "main": ".open-next/worker.js",
  "name": "hfi-utility-center",

  "compatibility_date": "2026-09-24",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "hfi-utility-center"
    }
  ],

  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "hfi-utility-center-opennext-cache"
    }
  ],

  "images": {
    "binding": "IMAGES"
  },

  "routes": [
    {
      "pattern": "hfiuc.org",
      "custom_domain": true,
    },
    {
    "pattern": "preview.hfiuc.org",
    "custom_domain": true,
    "previews_enabled": true,
    "enabled": false
  },
    {
      "pattern": "www.hfiuc.org",
      "custom_domain": true
    }
  ],

  "workers_dev": true,
  "preview_urls": true,

  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },

  "previews": {
    "services": [
      {
        "binding": "WORKER_SELF_REFERENCE",
        "service": "hfi-utility-center"
      }
    ],

    "r2_buckets": [
      {
        "binding": "NEXT_INC_CACHE_R2_BUCKET",
        "bucket_name": "hfi-utility-center-opennext-cache"
      }
    ],

    "images": {
      "binding": "IMAGES"
    },

    "vars": {
      "NEXT_INC_CACHE_R2_PREFIX": "preview"
    }
  }
}