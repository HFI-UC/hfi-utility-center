{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "hfi-utility-center",

  "compatibility_date": "2026-09-24",

  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash"
  },

  "routes": [
    {
      "pattern": "hfiuc.org",
      "custom_domain": true,
    },
    {
      "pattern": "preview.hfiuc.org",
      "custom_domain": true,
      "previews_enabled": true,
      "enabled": false
    },
    {
      "pattern": "www.hfiuc.org",
      "custom_domain": true
    }
  ],

  "workers_dev": true,
  "preview_urls": true,

  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
